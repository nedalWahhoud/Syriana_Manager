@page "/debt/{customerId:int}"
@namespace Syriana_Manager.Components.Layout
@inject IStringLocalizer<Syriana_Manager.Components.Layout.DebtPage> L
<div class="p-2 min-vh-100 w-100">
	<AuthorizeView>
		<Authorized Context="authContext">
			@if (!IsRendered.Initialized || !IsRendered.ParametersSet || !IsRendered.AfterRender)
			{
				<Syriana_Manager.Components.Layout.Loading />
			}
			else
			{
				@if (IsHasManageDebtPermission)
				{
					<div class="container-fluid px-2">
						<div class="d-flex align-items-center justify-content-between gap-2 mb-3">
							<button class="btn btn-sm btn-outline-danger ps-3"
							@onclick="GoBack"
							title="Zurück zur Liste">
								<i class="bi @(IsArabic ? "bi-arrow-return-right" : "bi-arrow-return-left") fs-5"></i>
							</button>
							<div class="d-flex align-items-center flex-grow-1 justify-content-center gap-3">
								<button class="btn btn-outline-secondary btn-sm" @onclick="PreviousDebtCustomer">
									<i class="bi @(IsArabic ? "bi-chevron-right" : "bi-chevron-left")"></i>
								</button>

								<div class="text-center flex-grow-1" style="max-width: 180px;">
									<h2 class="h6 m-0 text-truncate" title="@(customer?.Name_de)">
										<strong>@(IsArabic ? customer?.Name_ar : customer?.Name_de ?? "Fehler")</strong>
									</h2>
									<span class="badge rounded-pill bg-primary text-white" style="font-size: 0.75rem;">
										@L["StopNumber"]: @(customer?.StopNumber ?? 0)
									</span>
								</div>

								<button class="btn btn-outline-secondary btn-sm no-focus" @onclick="NextDebtCustomer">
									<i class="bi @(!IsArabic ? "bi-chevron-right" : "bi-chevron-left")"></i>
								</button>
							</div>
							<div class="dropdown">
								<button disabled="@IsProcessing"
								class="btn btn-light btn-sm rounded-circle shadow-sm border d-flex align-items-center justify-content-center"
								style="width: 35px; height: 35px;"
								type="button"
								data-bs-toggle="dropdown"
								data-bs-container="body">
									@if (IsProcessing)
									{
										<span class="spinner-border spinner-border-sm"
										role="status"
										aria-hidden="true"></span>
									}
									else
									{
										<span>⋮</span>
									}
								</button>
								<Syriana_Manager.Components.Layout.CustomDropdownLayout customer="customer" FilteredCustomers="null" Permissions="new (IsHasEditCustomersPermission,IsHasManageDebtPermission,IsHasCrateCustomerOneTimePaymentPermission)" OnHandel="HandleCustomDropdown" />
							</div>
						</div>
					</div>
					<div class="w-100">
						@* Schulden anzeigen *@
						<div class="card mb-3 shadow-sm">

							<div class="card-body text-center">
								<h5 class="text-muted mb-2">@L["CurrentDebtAmount"]</h5>
								<h2 class=" @(debtCustomers?.Balance > 0 ? "text-danger" : "text-success")  fw-bold">
									@(debtCustomers?.Balance.ToString("C", System.Globalization.CultureInfo.GetCultureInfo("de-DE")))
								</h2>
							</div>
						</div>
						@* schulden bearbeiten *@
						<div class="card shadow-sm m-3">
							<div class="card-body">
								<h5 class="mb-3">@L["AdjustDebts"]</h5>

								<div class="row g-3 align-items-end">
									<div class="col-md-6">
										<label class="form-label">@L["Amount"]</label>
										<InputNumber id="amountInput" inputmode="decimal" min="0" class="form-control text-center" @bind-Value="transactionsCustomers.AmountInput" @onfocus="@(e => SelectAllContent())" />
									</div>
									<div class="col-md-6 d-flex flex-column align-items-center justify-content-center gap-3">

										<!-- Aktueller Anstieg -->
										<div class="d-flex flex-column align-items-center">
											<div>
												<small class="text-muted text-center mb-1">@L["CurrentRise"]</small>
												@if (transactionsCustomers?.DraftType != null)
												{
													<span class="@(transactionsCustomers.DraftType == TransactionType.Repay ? "text-danger" : "text-success")">
														@(transactionsCustomers.DraftType == TransactionType.Repay ? " +" : " －")
													</span>
												}
											</div>
											<span class="fs-5 fw-semibold">@transactionsCustomers!.DraftAmount.ToString("C", System.Globalization.CultureInfo.GetCultureInfo("de-DE"))</span>
										</div>

										<!-- Gesamtsaldo -->
										<div class="d-flex flex-column align-items-center">
											<small class="text-muted text-center mb-1">@L["TotalBalance"]</small>
											<span class="fs-5 fw-bold">@((debtCustomers?.DraftBalance ?? 0).ToString("C", System.Globalization.CultureInfo.GetCultureInfo("de-DE"))) </span>
										</div>

									</div>

									<div class="col-md-6 d-flex justify-content-center gap-2">
										<button class="btn btn-danger d-flex align-items-center justify-content-center px-5 text-white fs-5"
										@onclick="() => PreviewTransaction(TransactionType.Repay)" disabled="@IsProcessing">
											＋
										</button>

										<button class="btn btn-success d-flex align-items-center justify-content-center px-5 text-white fs-5"
										@onclick="() => PreviewTransaction(TransactionType.Borrow)" disabled="@IsProcessing">
											－
										</button>
										<button class="btn btn-secondary d-flex align-items-center justify-content-center px-3 text-white fs-5"
										title="Default"
										@onclick="ResetToDefault" disabled="@IsProcessing">
											<i class="bi bi-arrow-counterclockwise"></i>
										</button>

									</div>
								</div>
							</div>
							<div class="row justify-content-center align-items-center m-2">
								<InputTextArea @bind-Value="transactionsCustomers.Notes" class="form-control" maxlength="255" placeholder="@L["Comments"]" />
							</div>
							<div class="row justify-content-center align-items-center mt-1 m-2" style="min-height: 120px;">

								<div class="col-12 col-md-auto d-flex justify-content-center mb-3 mb-md-0">
									<button class="btn btn-primary px-5 shadow-sm py-2"
									style="min-width: 200px; width: inherit;"
									@onclick="SaveTransactionAsync"
									disabled="@IsProcessing">
										@if (IsProcessing)
										{
											<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
										}
										else
										{
											<span class="fw-bold">@L["Save"]</span>
										}
									</button>
								</div>

								<div class="col-12 col-md-auto d-flex justify-content-center">
									<button class="btn btn-outline-success px-5 shadow-sm py-2"
									style="min-width: 200px; width: inherit;"
									@onclick="OnNotifyCustomer"
									disabled="@IsProcessing">
										@if (IsProcessing)
										{
											<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
										}
										else
										{
											<i class="bi bi-whatsapp me-2"></i> <span class="fw-bold">@L["NotifyCustomer"]</span>
										}
									</button>
								</div>
							</div>
						</div>
						@* transactions anzeigen *@
						<div class="tableResponsive p-3">
							<table class="table table-striped table-bordered mb-0">
								<thead class="table-dark">
									<tr>
										<th>@L["Id"]</th>
										<th>@L["CustomerId"]</th>
										<th>@L["Type"]</th>
										<th>@L["Amount"]</th>
										<th>@L["Created"]</th>
										<th>@L["Note"]</th>
									</tr>
								</thead>
								<tbody>
									@if (transactionsCustomersService.DownloadedTransactionsCustomers != null && transactionsCustomersService.DownloadedTransactionsCustomers.Any())
									{
										foreach (var t in transactionsCustomersService.DownloadedTransactionsCustomers)
										{
											<tr>
												<td>@t.Id</td>
												<td>@t.CustomerId</td>
												<td class="@(t.Type == TransactionType.Repay ? "text-success" : "text-danger")">
													@(TransactionType.Repay == t.Type ? "Zurückzahlen" : "Ausleihen")
												</td>
												<td>@t.Amount.ToString("C", System.Globalization.CultureInfo.GetCultureInfo("de-DE"))</td>
												<td>@t.TransactionDate.ToString("dd.MM.yyyy HH:mm 'Uhr'")</td>
												<td>@t.Notes</td>
											</tr>
										}
									}
									else
									{
										<tr>
											<td colspan="6" class="text-center">@L["NoTransactionsFound."]</td>
										</tr>
									}
								</tbody>
							</table>
							<div class="d-flex justify-content-center mt-3">
								<button @onclick="OnMoreLoadTransactionsCustomers" class="btn btn-success btnMobileSmall"
								disabled="@(transactionsCustomersService.GetItems.AllItemsLoaded || IsProcessing)">
									@if (IsProcessing)
									{
										<span class="spinner-border spinner-border-sm"
										role="status"
										aria-hidden="true"></span>
									}
									else if (transactionsCustomersService.GetItems.AllItemsLoaded)
									{
										<span>@L["AllLoaded"]</span>
									}
									else
									{
										<span>@L["Mehr Laden"]</span>
									}
								</button>
							</div>
						</div>
					</div>

					if (IsEditing)
					{
						<Syriana_Manager.Components.Layout.OverlayEditAddCustomers customer="EditingCustomer" Action="Edit" OnHandel="HandleEditAdd" />
					}

					@* map select *@
					<Syriana_Manager.Components.Layout.MapSelect />
				}
				else
				{
					<div style="display:flex; justify-content:center; align-items:center; height:80vh;">
						<div class="alert alert-danger text-center">
							@L["NoPermission"]
						</div>
					</div>
				}
			}
		</Authorized>
		<NotAuthorized>
			<Syriana_Manager.Pages.LogIn />
		</NotAuthorized>
	</AuthorizeView>
</div>
@code {
	/* debtCustomers funktion werden in trigger gemacht */
	[Parameter]
	public int customerId { get; set; }

	private Customers customer = null!;
	private DebtCustomers debtCustomers = null!;
	private TransactionsCustomers transactionsCustomers = new TransactionsCustomers();
	private bool IsHasManageDebtPermission = false;
	private bool IsHasCrateCustomerOneTimePaymentPermission = false;
	private bool IsHasEditCustomersPermission = false;
	protected override async Task OnInitializedAsync()
	{
		var authState = await authProvider.GetAuthenticationStateAsync();
		var user = authState.User;
		IsHasManageDebtPermission = user.HasClaim("permission", "manageDebt") ||
							user.HasClaim("permission", "fullAccess");

		IsHasEditCustomersPermission = user.HasClaim("permission", "editCustomers") || user.HasClaim("permission", "fullAccess");
		IsHasCrateCustomerOneTimePaymentPermission = user.HasClaim("permission", "crateCustomerOneTimePayment") || user.HasClaim("permission", "fullAccess");

		// afterRender  true, weil wir nutzen die funktion hier nicht
		IsRendered.AfterRender = true;
		IsRendered.Initialized = true;
	}
	protected override async Task OnParametersSetAsync()
	{
		if (IsHasManageDebtPermission)
		{
			customer = customersService.GetCustomerByIdLocal(customerId) ?? await customersService.GetCustomerByIdAsync(customerId);

			debtCustomers = await debtService.GetDebtCustomerByIdAsync(customerId);
			debtCustomers ??= new DebtCustomers { CustomerId = customerId, Balance = 0 };

			// initialize draft balance
			debtCustomers.DraftBalance = debtCustomers.Balance;
			// initialize  transactionsCustomersService und setze customerId für GetItems
			transactionsCustomersService.GetItems = new GetItems<TransactionsCustomers> {Filter = new() { Id = customerId, Type = GetItemFilterType.Custom }, PageSize = 10 };

			// clear list if customerId changed
			if (transactionsCustomersService.DownloadedTransactionsCustomers != null && transactionsCustomersService.DownloadedTransactionsCustomers.Count > 0
				&& transactionsCustomersService.DownloadedTransactionsCustomers[0].CustomerId != customerId)
			{
				transactionsCustomersService.DownloadedTransactionsCustomers = new List<TransactionsCustomers>();
			}
			// get first transactions
			await OnMoreLoadTransactionsCustomers();
		}
		IsRendered.ParametersSet = true;
	}
	private void PreviewTransaction(TransactionType transactionType)
	{
		if (transactionsCustomers.AmountInput <= 0)
			return;

		int sign = transactionType == TransactionType.Repay ? 1 : -1;
		transactionsCustomers.DraftAmount += sign * transactionsCustomers.AmountInput;
		debtCustomers.DraftBalance = debtCustomers.Balance + transactionsCustomers.DraftAmount;
		transactionsCustomers.DraftType = transactionType;
	}
	private async Task ResetToDefault()
	{
		transactionsCustomers.DraftAmount = 0;
		transactionsCustomers.AmountInput = 0;
		debtCustomers.DraftBalance = debtCustomers.Balance;
		transactionsCustomers = new ();

		await Task.Delay(50);
	}
	private bool IsProcessing = false;
	private async Task SaveTransactionAsync()
	{
		IsProcessing = true;

		if (transactionsCustomers.DraftAmount == 0)
		{
			await js.InvokeVoidAsync("alert", "gibt es nix zu ändern.");
			IsProcessing = false;
			return;
		}
		// set transaction type
		transactionsCustomers.Type = transactionsCustomers.DraftAmount > 0
				? TransactionType.Borrow
				: TransactionType.Repay;
		transactionsCustomers.Amount = Math.Abs(transactionsCustomers.DraftAmount);
		transactionsCustomers.CustomerId = customerId;


		var result = await transactionsCustomersService.AddTransaction(transactionsCustomers);
		if (result.Result == true)
		{
			debtCustomers = await debtService.GetDebtCustomerByIdAsync(customerId);
			debtCustomers ??= new DebtCustomers { CustomerId = customerId, Balance = 0 };

			// hasDebt ändern wenn den Betrag auf 0 gesetzt
			if (customer != null)
			{
				if (debtCustomers.Balance == 0)
					customer.HasDebt = false;
				else
					customer.HasDebt = true;
			}
			await ResetToDefault();

		}
		else
		{
			await js.InvokeVoidAsync("alert", result.Message);
		}

		IsProcessing = false;
	}

	private async Task OnNotifyCustomer()
	{
		var lastTransaction = transactionsCustomersService.DownloadedTransactionsCustomers
			.OrderBy(t => t.TransactionDate)
			.LastOrDefault(t => t.CustomerId == customerId);

		string token = transactionsCustomersService.GetCustomerNotificationToken(customerId);
		await whatsAppService.SendTransactionCustomerNotify(customer, debtCustomers, lastTransaction!, token);
	}
	// select all content in input when focus
	private async Task SelectAllContent()
	{
		try
		{
			// um sicherzustellen, dass der Browser den Fokussierungsprozess abgeschlossen hat
			await Task.Delay(10);
			await js.InvokeVoidAsync("selectTextById", "amountInput");
		}
		catch (Exception ex)
		{
			Console.WriteLine($"Error selecting input text: {ex.Message}");
		}
	}

	private async Task OnMoreLoadTransactionsCustomers()
	{
		IsProcessing = true;

		// Load more transactions
		await transactionsCustomersService.GetTransactionsCustomersAsync();

		IsProcessing = false;
	}
	private void GoBack()
	{
		navigationManager.NavigateTo("/customers");
	}

	private async Task NextDebtCustomer()
	{

		// wenn die Kundenliste noch nicht geladen ist, lade alle Kunden
		if (customersService.DownloadedCustomers == null ||
			customersService.DownloadedCustomers.Count == 0)
			await customersService.GetAllCustomersByLineId(customer.DistributionLineId);

		// sortiere die Kunden nach StopNumber innerhalb der gleichen DistributionLineId
		var sortedCustomers = customersService.DownloadedCustomers!
		.Where(c => c.DistributionLineId  == customer.DistributionLineId)
		.OrderBy(c => c.StopNumber).ToList();

		int currentIndex = sortedCustomers.FindIndex(c => c.Id == customerId);
		if (currentIndex != -1 && currentIndex < sortedCustomers.Count - 1)
		{
			var nextCustomer = sortedCustomers[currentIndex + 1];

			// Speichere die ID der ausgewählten Kategorie im Local Storage.
			await localStorageService.Set("selectedStopNummerId", nextCustomer.StopNumber);

			navigationManager.NavigateTo($"/debt/{nextCustomer.Id}");
		}
		else
		{
			await js.InvokeVoidAsync("alert", "Es gibt keinen nächsten Kunden auf der Liste.");
		}
	}
	private async Task PreviousDebtCustomer()
	{
		if (customersService.DownloadedCustomers == null || customersService.DownloadedCustomers.Count == 0)
			await customersService.GetAllCustomersByLineId(customer.DistributionLineId);

		var sortedCustomers = customersService.DownloadedCustomers!
			.Where(c => c.DistributionLineId == customer.DistributionLineId)
			.OrderBy(c => c.StopNumber).ToList();

		int currentIndex = sortedCustomers.FindIndex(c => c.Id == customerId);

		if (currentIndex > 0)
		{
			var previousCustomer = sortedCustomers[currentIndex - 1];

			// Speichere die ID der ausgewählten Kategorie im Local Storage.
			await localStorageService.Set("selectedStopNummerId", previousCustomer.StopNumber);


			navigationManager.NavigateTo($"/debt/{previousCustomer.Id}");

		}
		else
		{
			await js.InvokeVoidAsync("alert", "Dies ist der erste Kunde auf der Liste; es gibt keinen vorherigen Kunden.");
		}
	}

	private void HandleEditAdd((string action, CustomerProcess customerProcess) args)
	{
		 if (args.action == "Edit")
		{
			IsEditing = false;
			EditingCustomer = null!;
		}
		else if (args.action == "Cancel")
		{
			IsEditing = false;
			EditingCustomer = null!;
		}
		// nach dem Hinzufügen oder Bearbeiten einer Verteilungslinie die Liste der Verteilungslinien aktualisieren
		if (args.action == "Add" || args.action == "Edit")
			StateHasChanged();

	}
	// Handle Custom Dropdown Actions
	private bool IsEditing = false;
	private Customers EditingCustomer = null!;
	private void HandleCustomDropdown((string action, CustomerProcess customerProcess, bool IsEditing, OneTimePayment oneTimePayment, bool IsOneTimePaymentProcessing) args)
	{
		if (args.action == "Delete")
		{
			this.IsProcessing = args.customerProcess.IsProcessing;
		}
		else if (args.action == "Edit")
		{
			this.EditingCustomer = args.customerProcess.EditingCustomer;
			this.IsEditing = args.IsEditing!;
		}
	}
}