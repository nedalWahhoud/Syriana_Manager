@page "/register"

<div class="container">
	<p>A login account can only be assigned by the database Administrator. Please contact your database Administrator.</p>
	<button @onclick="OnBack" class="btn backB">Back to logIn Page</button>
</div>

@code {
	// back to login page
	[Parameter] public EventCallback OnBackToLogin { get; set; }
	private  void OnBack()
	{
		navigationManager!.NavigateTo("/login", false);
	}
	protected override void OnAfterRender(bool firstRender)
	{

	}
}
