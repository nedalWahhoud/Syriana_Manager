	// Delete Product
	private bool IsDeleting = false;
	private async Task DeleteProduct(Products SelectedProduct)
	{
		if (SelectedProduct == null || IsDeleting)
		{
			await js.InvokeVoidAsync("alert", "Please select a product");
			return;
		}
		// hide die context menu
		showContextMenu = false;
		// set deleting state
		IsDeleting = true;
		var resultConfirm = await js.InvokeAsync<bool>("confirm", $"Möchten Sie das Produkt mit der ID {SelectedProduct.Id} wirklich löschen?");
		if (resultConfirm)
		{

			var result = await productService.DeleteProductAsync(SelectedProduct.Id);
			if (result.Result)
			{
				productService.DownloadedProduct.RemoveAll(p => p.Id == SelectedProduct.Id);
				// wenn in filter mode
				if (filterP != null && filterP.Count > 0)
				{
					filterP.RemoveAll(p => p.Id == SelectedProduct.Id);
				}
				selectedRow = null;
				await js.InvokeVoidAsync("alert", result.Message ?? "Message ist Null");
			}
			else
			{
				await js.InvokeVoidAsync("alert", result.Message ?? "Message ist Null");
			}
		}
		else
		{
			// User cancelled the deletion
		}

		// reset deleting state
		IsDeleting = false;
	}
	// Edit Product
	private Products _editProduct = null!;
	private Products newProduct = new Products();
	private async Task EditProduct(Products SelectedProduct)
	{
		if (SelectedProduct == null)
		{
			await js.InvokeVoidAsync("alert", "Please select a product");
			return;
		}
		// hide die context menu
		showContextMenu = false;
		// erlaubt keine Änderung von Produkten, wenn Kassenbon oder Rechnung angezeigt wird
		if (!IsShowInvoice && SelectedProduct != null)
		{
			// cancel all other processes
			IsShowAddProductForm = false;

			// new products create to so that both (products and editproduct) do not reference the same instance.
			_editProduct = new Products
				{
					Id = SelectedProduct.Id,
					Name_de = SelectedProduct.Name_de,
					Description_de = SelectedProduct.Description_de,
					Name_ar = SelectedProduct.Name_ar,
					Description_ar = SelectedProduct.Description_ar,
					CategoryId = SelectedProduct.CategoryId,
					//	Category = doubleSelectProduct.Category,
					Quantity = SelectedProduct.Quantity,
					PurchasePrice = SelectedProduct.PurchasePrice,
					SalePrice = SelectedProduct.SalePrice,
					MinimumStock = SelectedProduct.MinimumStock,
					EXPDate = SelectedProduct.EXPDate,
					PackagingUnit = SelectedProduct.PackagingUnit,
					ItemsPerPackage = SelectedProduct.ItemsPerPackage,
					SelectedSupplierIds = SelectedProduct.SelectedSupplierIds ?? new(),
					Suppliers = SelectedProduct.Suppliers,
					//Manufacturer = doubleSelectProduct.Manufacturer,
					TaxRateId = SelectedProduct.TaxRateId,
					ProductGroupID = SelectedProduct.ProductGroupID,
					IsShippable = SelectedProduct.IsShippable,
					//DiscountedPrice = SelectedProduct.DiscountedPrice,
					ProductDiscount = (selectedProduct?.ProductDiscount == null)
			                        ? new ()
			                        : new ()
		             {
				          Id = selectedProduct.ProductDiscount.Id,
				          ProductsId = selectedProduct.ProductDiscount.ProductsId,
				          DiscountedPrice = selectedProduct.ProductDiscount.DiscountedPrice,
				          StartDate = selectedProduct.ProductDiscount.StartDate,
				          EndDate = selectedProduct.ProductDiscount.EndDate
			         },
					//Image = SelectedProduct.Image,
					ProductImages = SelectedProduct.ProductImages?
		             .Select(img => new ProductImages
		             {
	 		           Id = img.Id,
			           ProductId = img.ProductId,
			           ImageUrl = img.ImageUrl,
			           IsMain = img.IsMain,
			           ImageBytes = img.ImageBytes,
			           LastModified = img.LastModified
		             })
		             .ToList() ?? new List<ProductImages>(),
					UserId = user?.Id ?? 0,
					CartItem = SelectedProduct.CartItem
				};
		}
	}
	// Overlay Form Handel
	private void HandleEditProduct((Products product, string Action) data)
	{
		if (data.Action == "Edit")
		{
			// edit if in Filter mode
			if (data.product != null)
			{
				if (filterP != null && filterP.Count > 0)
				{
					int filterIndex = filterP.FindIndex(p => p.Id == data.product.Id);
					if (filterIndex >= 0)
					{
						filterP[filterIndex] = data.product; // Update the product in the filtered list
					}
				}
				data.product = null!;
			}
			// Hide the edit form
			_editProduct = null!;
		}
		else if (data.Action == "Add")
		{
			// add if in Filter mode
			if (data.product != null)
			{
				if (filterP != null && filterP.Count > 0)
				{
					// Add the new product to the filtered list
					filterP.Insert(0, data.product);
				}
			}

			// Hide the add form
			IsShowAddProductForm = false;
			newProduct = new();
		}
		else
		{
			IsShowAddProductForm = false;
			newProduct = new();
			_editProduct = null!;
		}
	}
