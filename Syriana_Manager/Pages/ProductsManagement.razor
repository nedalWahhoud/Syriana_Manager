	// Select
	private Products? selectedRow;
	private void OnDoubleTap(Products product, MouseEventArgs e)
	{
		if (_editProduct != null || IsShowAddProductForm || IsDeleting || IsShowInvoice || IsShowOrder)
			return;

		selectedProduct = product;
		selectedRow = product;

		menuX = e.ClientX;
		menuY = e.ClientY;
		showContextMenu = true;

		StateHasChanged();
	}
	private void OnSelectRow(Products product, MouseEventArgs e)
	{
		if (_editProduct != null || IsShowAddProductForm || IsDeleting || IsShowInvoice || IsShowOrder)
			return;

		if (e.Button == 2)
		{
			selectedProduct = product;
			menuX = e.ClientX;
			menuY = e.ClientY;
			showContextMenu = true;
		}

		selectedRow = product;
	}
	// Add Product
	private bool IsShowAddProductForm = false;
	private async void ShowAddProductFormAsync()
	{
		// cancel all other processes
		_editProduct = null!;

		// get the categories and manufacturers and taxrates
		if (!taskCatyrories.IsCompleted)
			await taskCatyrories;
		if (!taskSuppliers.IsCompleted)
