	private int selectedCategoryId = 0;
	private async Task OnCategoryChanged()
	{
		// reset values filter
		selectedValuesFilter = 0;
		filterP = null!;
		if (selectedCategoryId == 0)
		{
			// if selectedId is 0, clear the filter
			filterP = null!;
			// reset die Getitem 
			getItems = new();

			await loadInBackground();
		}
		else
		{
			// Legen Sie den Filter für die Kategorie-ID fest, um die Produkte anhand der Kategorie-ID zu erhalten.
			getItems = new() { Filter = new() { Id = selectedCategoryId, Type = GetItemFilterType.Category }, Includes = ProductIncludes.Category | ProductIncludes.ProductImages | ProductIncludes.Suppliers | ProductIncludes.ProductDiscount };
			var moreProducts = await loadInBackground();

			// get the products by categoryId local, after downloading from server
			filterP = moreProducts.Items;
		}

		// save the selected category id in local storage
		await localStorageService.Set("selectedCategoryId", selectedCategoryId);
		StateHasChanged();
	}
	// filter nach Lagerbestand
	private int selectedValuesFilter = 0;
	private async Task OnFilterChanged()
	{
		// reset category filter
		selectedCategoryId = 0;
		filterP = null!;

		if (selectedValuesFilter == 1)
		{
			// Legen Sie den Filter für die Kategorie-ID fest, um die Produkte anhand der Kategorie-ID zu erhalten.
			getItems = new() { Filter = new() { Id = 0, Type = GetItemFilterType.LowStock }, Includes = ProductIncludes.Category | ProductIncludes.ProductImages | ProductIncludes.Suppliers | ProductIncludes.ProductDiscount };
			var moreProducts = await loadInBackground();

			filterP = moreProducts.Items;
		}
		else if (selectedValuesFilter == 2)
		{
			// Legen Sie den Filter für die Kategorie-ID fest, um die Produkte anhand der Kategorie-ID zu erhalten.
			getItems = new() { Filter = new() { Id = 0, Type = GetItemFilterType.OnOffer }, Includes = ProductIncludes.Category | ProductIncludes.ProductImages | ProductIncludes.Suppliers | ProductIncludes.ProductDiscount };
			var moreProducts = await loadInBackground();

			filterP = moreProducts.Items;
		}
		else
		{
			filterP = null!;
			// reset die Getitem
			getItems = new();
		}
		StateHasChanged();
	}
