	private async Task OnInvoiceGenerate()
	{
		// oder
		Order createOrder = new Order()
			{
				StatusId = 1, // in database 1 = Order Pending
				OrderItems = cartService.CartItems.Select(item => new OrderItems
				{
					ProductId = item.ProductId,
					Quantity = item.Quantity,
					UnitPrice = item.Product?.SalePrice ?? 0,
					CategoryId = item.Product?.CategoryId ?? 0
				}).ToList(),
				TotalPrice = order.TotalPrice,
				OrderDate = DateTime.Now,
				UserId = user?.Id ?? 0,
				DiscountCodeId = order.DiscountCodeId ?? null,
				DiscountCode = discountCode.Id > 0 ? discountCode : null,
				DiscountCategoryId = order.DiscountCategoryId ?? null,
				DiscountCategory = discountCategory.Id > 0 ? discountCategory : null,
				ShippingProviderId = order.ShippingProviderId ?? null,
				Address = newAddress,
				IsUserCreated = false
			};

		// get the products for the order items
		foreach (var item in createOrder.OrderItems)
		{
			item.Product = productService.GetProductByIdLocal(item.ProductId) ?? await productService.GetProductByIdAsync(item.ProductId);
			if (item.Product != null && item.Product.TaxRate == null)
				item.Product.TaxRate = taxRateService.GetTasRateLocal(item.Product.TaxRateId) ?? await taxRateService.GetTaxRateByIdAsync(item.Product.TaxRateId);
		}

		// add the discount code to the order
		if (order.DiscountCodeId != null && order.DiscountCodeId > 0)
		{
			order.DiscountCode = discountCode;
		}
		else if (order.DiscountCategoryId != null && order.DiscountCategoryId > 0)
		{
			order.DiscountCategory = discountCategory;
		}

		invoice = new Invoice
			{
				InvoceeNumber = $"RE-{DateTime.Now:yyyyMMdd}{Random.Shared.Next(1000, 9999)}",
				CurrentOrder = createOrder,
			};

		IsInvoiceVisible = true;
		IsShowOrder = false;
	}
