	// barcode scanning
	private bool ShowScanner = false;
	private async Task OpenScanner()
	{
		ShowScanner = true;
		StateHasChanged(); // Wir bitten Blizzard, zuerst das "Reder"-Div zu zeichnen.

		await Task.Delay(100); // Eine kurze Verzögerung, um sicherzustellen, dass der Browser das Element gezeichnet hat.
		try
		{
			// JavaScript aufrufen und Kamera starten
			await js.InvokeVoidAsync("startLiveScanner", DotNetObjectReference.Create(this));
		}
		catch(Exception ex)
		{
			await js.InvokeVoidAsync("alert", ex.Message);
		}
	}
	[JSInvokable]
	public async Task OnBarcodeScanned(string code)
	{
		// Diese Funktion wird unmittelbar nach dem Einlesen des Codes von JavaScript aufgerufen.
		if (!string.IsNullOrEmpty(code) && (selectedProduct != null && selectedProduct.Id != 0))
		{

			var result = await productService.UpdateBarcodeAsync(selectedProduct.Id, code);
			if (result.Result)
			{
				selectedProduct.Barcode = code;
				ShowScanner = false;
				showContextMenu = false;
				StateHasChanged();
				return;
			}
			else
			{
				await js.InvokeVoidAsync("alert", result.Message);
				await OpenScanner();
				return;
			}
		}
		else
			await js.InvokeVoidAsync("alert", "code oder selectedProduct ist null");
	}
	private async Task CloseScanner()
	{
		try
		{
			await js.InvokeVoidAsync("stopLiveScanner");
		}
		catch (Exception ex)
		{
			await js.InvokeVoidAsync("alert", ex.Message);
		}
		ShowScanner = false;
		showContextMenu = false;
	}
